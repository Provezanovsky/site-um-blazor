@page "/placar"
@rendermode InteractiveServer

<PageTitle>Placar Interativo</PageTitle>
<p class="eyebrow">Exercício 04</p>
<h1>Placar Interativo</h1>
<p class="intro">Atualize a pontuação do jogo. O placar nunca fica negativo.</p>

<section class="exercise" aria-label="Placar do jogo">
    <p class="score" aria-live="polite">Pontos: @pontos</p>
    <div class="button-group">
        <button type="button" @onclick="SomarPonto">Somar 1 Ponto</button>
        <button type="button" @onclick="SubtrairPonto">Subtrair 1 Ponto</button>
        <button type="button" @onclick="ZerarPlacar">Zerar Placar</button>
    </div>
</section>

@code {
    private int pontos = 0;

    private void SomarPonto()
    {
        pontos++;
    }

    private void SubtrairPonto()
    {
        pontos = Math.Max(0, pontos - 1);
    }

    private void ZerarPlacar()
    {
        pontos = 0;
    }
}
